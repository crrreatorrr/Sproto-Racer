{
  "name": "sproto-racing",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:server-sim": "node scripts/build-server-sim.mjs",
    "check:server-sim": "node scripts/build-server-sim.mjs --check",
    "preview": "vite preview --host 127.0.0.1",
    "test:qa": "for f in qa/*.mjs; do node --import ./tests/register-sdk-hook.js \"$f\" || exit 1; done",
    "test": "npm run check:server-sim && vitest run && node --import ./tests/register-sdk-hook.js --test tests/*.test.js"
  },
  "dependencies": {
    "@metaverse/hub-sdk": "file:vendor/hub-sdk",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "type": "module",
  "private": true
}
